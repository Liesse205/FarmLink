# FarmLink environment variables.
# Copy to .env (which is git-ignored) and fill in the real values.
# Nothing in this project hard-codes secrets: every value below is read with
# a ${VARIABLE:default} placeholder from backend/src/main/resources/application.yml.

# --- Docker Compose services (defaults already match docker-compose.yml) ----
DATABASE_PASSWORD=farmlink
RABBITMQ_PASSWORD=farmlink

# --- Google OAuth2 / OIDC login -------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorized redirect URI (exact):
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Role assignment (first login creates the FarmLink user) ---------------
# ADMIN_EMAILS: comma separated addresses that become ADMIN on every login.
# This is the ONLY way to get an admin account — it can never be self-selected.
#   e.g. ADMIN_EMAILS=munyanturirekalizaliesse@gmail.com
# FARMER_EMAILS: optional shortcut — these become FARMER on first login.
# Everyone else gets NO role until they pick FARMER or BUYER on the
# first-time onboarding screen.
FARMER_EMAILS=
ADMIN_EMAILS=

# --- Frontend origin (CORS + redirect after Google login) ------------------
FARMLINK_FRONTEND_URL=http://localhost:5173
